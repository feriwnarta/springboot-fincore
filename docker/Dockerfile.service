FROM maven:3.9.9-eclipse-temurin-21 AS build

ARG SERVICE
WORKDIR /workspace
COPY pom.xml .
COPY libraries ./libraries
COPY services ./services
RUN mvn -q -pl services/${SERVICE} -am -Dmaven.test.skip=true -Dcheckstyle.skip=true package

FROM eclipse-temurin:21-jre

ARG SERVICE
WORKDIR /app
RUN useradd --system --uid 10001 --create-home fincore
COPY --from=build /workspace/services/${SERVICE}/target/${SERVICE}-0.1.0-SNAPSHOT.jar /app/app.jar
RUN chown -R fincore:fincore /app
USER fincore
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
